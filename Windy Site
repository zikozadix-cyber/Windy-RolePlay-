<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#070b14">
<meta name="description" content="Windy City RolePlay — SA-MP Mobile roleplay community.">
<title>Windy City RolePlay | Official</title>
<style>
:root{--bg:#070b14;--panel:#0d1625;--blue:#28a9ff;--cyan:#67d7ff;--text:#edf6ff;--muted:#9aaec3;--line:rgba(103,215,255,.18)}
*{box-sizing:border-box;scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 70% 0%,#10294a 0%,transparent 40%),var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,Arial,sans-serif}a{color:inherit;text-decoration:none}.wrap{width:min(1120px,92%);margin:auto}
header{position:sticky;top:0;z-index:10;background:#070b14e8;backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.nav{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:11px;font-weight:900;letter-spacing:.4px}.logo{width:42px;height:42px;border-radius:13px;background:linear-gradient(135deg,var(--blue),#1450a0);display:grid;place-items:center;box-shadow:0 0 25px #1689e955;font-size:20px}.brand small{display:block;font-size:10px;letter-spacing:2px;color:var(--cyan);font-weight:700;margin-top:3px}.links{display:flex;gap:20px;align-items:center;font-size:13px;color:var(--muted)}.links a:hover{color:white}
.btn{display:inline-flex;justify-content:center;align-items:center;gap:8px;border:1px solid #36b5ff66;background:linear-gradient(135deg,#159cf0,#1764c2);padding:12px 18px;border-radius:10px;color:white;font-weight:800;font-size:13px;cursor:pointer}.btn.secondary{background:#0d192a;border-color:var(--line)}.hero{padding:80px 0 62px;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:38px}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--cyan);font-size:11px;font-weight:900;letter-spacing:2px;border:1px solid var(--line);padding:8px 12px;border-radius:99px;background:#0b1728}.dot{width:7px;height:7px;border-radius:50%;background:#53d8ff;box-shadow:0 0 12px #53d8ff}
h1{font-size:clamp(42px,6vw,72px);line-height:.99;letter-spacing:-2.8px;margin:23px 0 20px;font-weight:950}h1 span{color:var(--blue);text-shadow:0 0 32px #168de844}.lead{max-width:560px;color:var(--muted);line-height:1.8;font-size:15px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:27px}.hero-art{position:relative;min-height:350px;border:1px solid var(--line);border-radius:28px;overflow:hidden;background:linear-gradient(160deg,#102744,#09111f 65%);display:flex;align-items:end;padding:25px}.city{position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,#070b14 100%),repeating-linear-gradient(90deg,transparent 0 27px,#1a5d8a18 28px 29px)}.skyline{position:absolute;bottom:0;left:0;right:0;height:72%;display:flex;align-items:end;justify-content:center;gap:7px}.building{width:11%;background:linear-gradient(180deg,#173a5b,#091321);border:1px solid #4cbcff33;position:relative}.building:before{content:"";position:absolute;inset:12px 6px;background:repeating-linear-gradient(0deg,#50caff66 0 3px,transparent 3px 15px)}.b1{height:45%}.b2{height:67%}.b3{height:55%}.b4{height:92%;width:14%}.b5{height:73%}.b6{height:49%}.b7{height:62%}.big-mark{position:absolute;top:35px;left:0;right:0;text-align:center;font-size:clamp(70px,12vw,130px);font-weight:1000;color:#43bdff14;letter-spacing:-10px}.art-caption{position:relative;z-index:1;width:100%;border:1px solid #70d8ff30;background:#07101dd9;padding:16px;border-radius:15px;display:flex;justify-content:space-between;gap:12px;align-items:center}.art-caption strong{display:block;font-size:14px}.art-caption small{color:var(--muted)}
.section{padding:42px 0 55px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:23px}.kicker{font-size:10px;color:var(--cyan);letter-spacing:2px;font-weight:900}.section h2,.formbox h2{font-size:clamp(26px,4vw,38px);letter-spacing:-1px;margin:8px 0 0}.sub{color:var(--muted);font-size:13px;line-height:1.7;max-width:560px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.card{background:linear-gradient(145deg,#101c2e,#0a111e);border:1px solid var(--line);border-radius:17px;padding:22px;min-height:155px;transition:.2s}.card:hover{transform:translateY(-3px);border-color:#36b5ff66}.icon{width:42px;height:42px;border-radius:12px;background:#128fe51c;border:1px solid #38baff30;display:grid;place-items:center;color:var(--cyan);font-size:20px;margin-bottom:16px}.card h3{margin:0 0 8px;font-size:16px}.card p{margin:0;color:var(--muted);font-size:13px;line-height:1.7}.faction-top{display:flex;align-items:center;gap:14px}.faction-symbol{width:48px;height:48px;display:grid;place-items:center;border-radius:14px;background:#102e4a;color:#62ceff;font-size:22px;border:1px solid #2a9ce444;flex-shrink:0}.tag{display:inline-block;border:1px solid var(--line);border-radius:6px;padding:4px 7px;color:var(--cyan);font-size:10px;font-weight:800;margin-top:12px}
.rules{display:grid;grid-template-columns:1fr 1fr;gap:12px}.rule{display:flex;gap:13px;padding:17px;border-radius:13px;border:1px solid var(--line);background:#0b1320}.num{color:var(--cyan);font-weight:900;font-size:12px}.rule strong{font-size:14px;display:block;margin-bottom:5px}.rule p{font-size:12px;color:var(--muted);line-height:1.6;margin:0}
.serverbox{display:flex;align-items:center;justify-content:space-between;gap:16px;background:linear-gradient(135deg,#10233a,#0a111d);border:1px solid var(--line);border-radius:17px;padding:20px}.serverbox strong{display:block}.serverbox small{color:var(--muted)}.status{color:var(--cyan);font-size:12px;font-weight:900;border:1px solid var(--line);border-radius:8px;padding:9px 12px;white-space:nowrap}
.formbox{display:grid;grid-template-columns:.8fr 1.2fr;gap:28px;padding:28px;background:linear-gradient(135deg,#0e2035,#0a111d);border:1px solid var(--line);border-radius:22px}.formbox p{color:var(--muted);font-size:13px;line-height:1.8}form{display:grid;grid-template-columns:1fr 1fr;gap:12px}label{display:block;color:#bdd0e2;font-size:11px;font-weight:800;margin-bottom:7px}input,select,textarea{width:100%;background:#070d17;border:1px solid #25415d;color:white;padding:12px;border-radius:9px;font:inherit;font-size:13px;outline:none}input:focus,select:focus,textarea:focus{border-color:var(--blue)}.full{grid-column:1/-1}.notice{font-size:11px;color:#92a8bd;margin-top:10px;line-height:1.6}#toast{display:none;margin-top:12px;padding:12px;border-radius:9px;background:#0b2a3b;border:1px solid #2f9fd2;color:#dff7ff;font-size:12px}footer{border-top:1px solid var(--line);padding:26px 0;color:var(--muted);font-size:12px;margin-top:35px}.foot{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}.menu-btn{display:none;background:none;color:white;border:1px solid var(--line);padding:8px 11px;border-radius:8px}
@media(max-width:800px){.hero{grid-template-columns:1fr;padding-top:55px}.hero-art{min-height:290px}.grid{grid-template-columns:1fr 1fr}.formbox{grid-template-columns:1fr}.links{gap:12px}}
@media(max-width:560px){.links{display:none;position:absolute;top:72px;left:0;right:0;background:#08101d;padding:18px 4%;border-bottom:1px solid var(--line);flex-direction:column;align-items:flex-start}.links.open{display:flex}.menu-btn{display:block}.nav>.btn{display:none}.grid,.rules{grid-template-columns:1fr}h1{letter-spacing:-1.8px}.hero{padding-bottom:35px}.section-head{align-items:start;flex-direction:column}.formbox{padding:20px}form{grid-template-columns:1fr}.full{grid-column:auto}.serverbox{align-items:flex-start;flex-direction:column}}
</style>
</head>
<body>
<header><div class="wrap nav">
<a class="brand" href="#home"><span class="logo">W</span><span>WINDY CITY<small>ROLEPLAY • SA-MP MOBILE</small></span></a>
<nav class="links" id="navlinks"><a href="#home">Home</a><a href="#about">About</a><a href="#factions">Factions</a><a href="#rules">Rules</a><a href="#apply">Apply</a></nav>
<a class="btn" href="#apply">JOIN THE CITY ↗</a><button class="menu-btn" onclick="document.getElementById('navlinks').classList.toggle('open')" aria-label="Open menu">☰</button>
</div></header>
<main>
<section class="wrap hero" id="home"><div>
<div class="eyebrow"><span class="dot"></span> YOUR STORY STARTS HERE</div>
<h1>WELCOME TO<br><span>WINDY CITY</span><br>ROLEPLAY</h1>
<p class="lead">Build your story. Find your crew. Make your name. Join a roleplay community where every decision can shape your next chapter.</p>
<div class="actions"><a class="btn" href="#about">EXPLORE THE CITY ↘</a><a class="btn secondary" href="#factions">DISCOVER FACTIONS</a></div>
<p class="notice">SA-MP Mobile community • Server connection details coming soon</p></div>
<div class="hero-art" aria-label="Stylized blue city skyline"><div class="city"></div><div class="big-mark">WCRP</div><div class="skyline"><div class="building b1"></div><div class="building b2"></div><div class="building b3"></div><div class="building b4"></div><div class="building b5"></div><div class="building b6"></div><div class="building b7"></div></div><div class="art-caption"><div><strong>WINDY CITY ROLEPLAY</strong><small>New city. New possibilities.</small></div><span class="eyebrow">WCRP</span></div></div>
</section>
<section class="section wrap" id="about"><div class="section-head"><div><div class="kicker">ABOUT THE CITY</div><h2>More than just a game.</h2></div><p class="sub">Create a character, meet new people, and make your own path in the city. Your story starts here.</p></div>
<div class="grid"><article class="card"><div class="icon">✦</div><h3>Immersive RolePlay</h3><p>Play your character consistently, respect the scene, and help create memorable stories.</p></article><article class="card"><div class="icon">♙</div><h3>Community First</h3><p>Respect other players and work together to keep the city welcoming and fair.</p></article><article class="card"><div class="icon">⌘</div><h3>Build Your Future</h3><p>Discover opportunities, meet factions, and find the role that suits your character.</p></article></div></section>
<section class="section wrap" id="server"><div class="section-head"><div><div class="kicker">SERVER INFORMATION</div><h2>Connect to the city.</h2></div><p class="sub">Connection details will be announced when the server is ready.</p></div>
<div class="serverbox"><div><strong>Windy City RolePlay — SA-MP Mobile</strong><small>Server IP: Coming Soon</small></div><span class="status">COMING SOON</span></div></section>
<section class="section wrap" id="factions"><div class="section-head"><div><div class="kicker">FIND YOUR PLACE</div><h2>Our Factions</h2></div><p class="sub">Explore the departments and teams planned for Windy City RolePlay.</p></div>
<div class="grid">
<article class="card"><div class="faction-top"><div class="faction-symbol">✚</div><div><h3>LSPD</h3><p>Los Santos Police Department</p></div></div><span class="tag">LAW ENFORCEMENT</span></article>
<article class="card"><div class="faction-top"><div class="faction-symbol">✚</div><div><h3>MEDIC</h3><p>Medical & emergency services</p></div></div><span class="tag">MEDICAL</span></article>
<article class="card"><div class="faction-top"><div class="faction-symbol">◈</div><div><h3>CIA</h3><p>Intelligence department</p></div></div><span class="tag">GOVERNMENT</span></article>
<article class="card"><div class="faction-top"><div class="faction-symbol">◈</div><div><h3>FBI</h3><p>Federal investigations</p></div></div><span class="tag">FEDERAL</span></article>
<article class="card"><div class="faction-top"><div class="faction-symbol">★</div><div><h3>SWAT</h3><p>Special response unit</p></div></div><span class="tag">SPECIAL UNIT</span></article>
<article class="card"><div class="faction-top"><div class="faction-symbol">✦</div><div><h3>SHERIFF</h3><p>County law enforcement</p></div></div><span class="tag">LAW ENFORCEMENT</span></article>
<article class="card"><div class="faction-top"><div class="faction-symbol">⬟</div><div><h3>ARMY</h3><p>Military department</p></div></div><span class="tag">MILITARY</span></article>
</div><p class="notice">Faction descriptions are introductory placeholders. Update them to match your server's official rules and organization.</p></section>
<section class="section wrap" id="rules"><div class="section-head"><div><div class="kicker">KEEP IT FAIR</div><h2>City Rules</h2></div><p class="sub">Follow these starter community rules. Add the complete official rulebook before launch.</p></div>
<div class="rules">
<div class="rule"><span class="num">01</span><div><strong>Respect Everyone</strong><p>No harassment, hate speech, or personal attacks against other players.</p></div></div>
<div class="rule"><span class="num">02</span><div><strong>Stay In Character</strong><p>Keep roleplay scenes believable and avoid disrupting other players' stories.</p></div></div>
<div class="rule"><span class="num">03</span><div><strong>No Cheats or Exploits</strong><p>Play fairly. Do not use cheats, unauthorized tools, or bugs to gain an advantage.</p></div></div>
<div class="rule"><span class="num">04</span><div><strong>Follow Staff Instructions</strong><p>Listen to moderators and use the proper channels to appeal a decision.</p></div></div>
<div class="rule"><span class="num">05</span><div><strong>Respect Roleplay Scenes</strong><p>Avoid random actions that break scenes or prevent others from roleplaying.</p></div></div>
<div class="rule"><span class="num">06</span><div><strong>Protect Your Account</strong><p>Never share passwords or private account information with other players.</p></div></div>
</div></section>
<section class="section wrap" id="apply"><div class="formbox"><div><div class="kicker">TAKE THE NEXT STEP</div><h2>Join the city.</h2><p>Interested in joining a faction or the Staff Team? Use this demo form to preview an application. It will not send or store submissions until connected to a real form service.</p><a class="btn secondary" href="#server">SERVER INFO</a></div>
<div><form id="application"><div><label for="player">PLAYER NAME</label><input id="player" name="player" placeholder="Your in-game name" required></div><div><label for="age">AGE</label><input id="age" name="age" type="number" min="13" max="99" placeholder="Your age" required></div><div><label for="type">APPLICATION TYPE</label><select id="type" name="type"><option>Faction Application</option><option>Staff Application</option><option>General Question</option></select></div><div><label for="faction">FACTION / TEAM</label><select id="faction" name="faction"><option>LSPD</option><option>MEDIC</option><option>CIA</option><option>FBI</option><option>SWAT</option><option>SHERIFF</option><option>ARMY</option><option>Staff Team</option></select></div><div class="full"><label for="message">WHY DO YOU WANT TO JOIN?</label><textarea id="message" name="message" rows="3" placeholder="Write a short introduction..." required></textarea></div><div class="full"><button class="btn" type="submit">PREVIEW APPLICATION ↗</button><div id="toast" role="status"></div><p class="notice">Demo form only: it does not send or store applications yet. Discord link: coming soon.</p></div></form></div></div></section>
</main>
<footer><div class="wrap foot"><div><strong>WINDY CITY ROLEPLAY</strong><div class="notice">SA-MP Mobile • Community Website</div></div><div>Official Discord and server IP: Coming Soon</div><div>© <span id="year"></span> WCRP</div></div></footer>
<script>
document.getElementById('year').textContent=new Date().getFullYear();
document.querySelectorAll('.links a').forEach(a=>a.addEventListener('click',()=>document.getElementById('navlinks').classList.remove('open')));
document.getElementById('application').addEventListener('submit',function(e){e.preventDefault();const d=new FormData(this);const toast=document.getElementById('toast');toast.style.display='block';toast.textContent='Preview ready for '+d.get('player')+' — '+d.get('type')+' ('+d.get('faction')+'). This demo has not sent your application.';});
</script>
</body></html>
